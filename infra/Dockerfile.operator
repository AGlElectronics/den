# syntax=docker/dockerfile:1.7

# -----------------------------------------------------------------------------
# Den operator: module database provisioning + encrypted suite backups.
# The runtime is the Postgres image so pg_dump/pg_restore match the server's
# major version (keep both on 16). `age` is included for restores.
# See docs/operations.md at the repository root.
# -----------------------------------------------------------------------------
FROM golang:1.25-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-buildvcs=false

COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY backend ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -trimpath -ldflags "-s -w" -o /out/den-operator ./cmd/operator

FROM postgres:16-alpine
RUN apk add --no-cache age
COPY --from=build /out/den-operator /usr/local/bin/den-operator
USER postgres
WORKDIR /tmp
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/den-operator"]
