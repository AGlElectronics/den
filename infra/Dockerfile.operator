# syntax=docker/dockerfile:1.7

# -----------------------------------------------------------------------------
# Den operator: module database provisioning + encrypted suite backups.
# The runtime is plain Alpine with only the PostgreSQL client tools
# (pg_dump, pg_dumpall, pg_restore, psql), whose major version must match
# the server's (keep both on 16). `age` is included for restores.
# See docs/operations.md at the repository root.
# -----------------------------------------------------------------------------
FROM golang:1.27.3-alpine3.24 AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-buildvcs=false

COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY backend ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -trimpath -ldflags "-s -w" -o /out/den-operator ./cmd/operator

FROM alpine:3.24.4
# postgresql16-client creates the "postgres" user (UID/GID 70), which the
# Kubernetes manifests and the Helm chart run the operator as.
RUN apk add --no-cache postgresql16-client age && \
    test "$(id -u postgres):$(id -g postgres)" = "70:70"
COPY --from=build /out/den-operator /usr/local/bin/den-operator
USER 70:70
WORKDIR /tmp
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/den-operator"]
