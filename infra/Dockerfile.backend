# syntax=docker/dockerfile:1.7

# -----------------------------------------------------------------------------
# Den backend image. Builds BOTH binaries from the same source tree:
#   /den-server   — the HTTP API (never runs migrations)
#   /den-migrate  — one-shot Goose runner used by Compose + K8s Jobs
# The default entrypoint is the server; the compose `migrate` service
# overrides it with `/den-migrate`. See docs/adr/0005-no-shared-postgres.md.
# -----------------------------------------------------------------------------
FROM golang:1.27.3-alpine3.24 AS build
WORKDIR /src

ENV CGO_ENABLED=0 GOFLAGS=-buildvcs=false

# sqlc generates backend/internal/repository/sqlcgen/ from queries/*.sql at
# build time. The directory is gitignored — CI regenerates it on every job
# and this Dockerfile does the same so a plain `docker build .` works
# without any host-side prep. Keep SQLC_VERSION in sync with the Den CI
# pipeline when we add one. Mirrors the Stash backend Dockerfile.
ARG SQLC_VERSION=v1.30.0
RUN apk add --no-cache wget ca-certificates tar && \
    arch="$(uname -m)" && \
    case "$arch" in \
        x86_64) sqlc_arch=amd64 ;; \
        aarch64) sqlc_arch=arm64 ;; \
        *) echo "unsupported architecture $arch" >&2; exit 1 ;; \
    esac && \
    ver="${SQLC_VERSION#v}" && \
    wget -qO- "https://github.com/sqlc-dev/sqlc/releases/download/${SQLC_VERSION}/sqlc_${ver}_linux_${sqlc_arch}.tar.gz" \
        | tar -xz -C /usr/local/bin sqlc && \
    chmod +x /usr/local/bin/sqlc && \
    sqlc version

COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY backend ./

# Wipe whatever the local checkout had under sqlcgen/ (stale code from a
# previous `sqlc generate` run) and regenerate it from the queries we just
# copied in. Without this step, schema/query changes that haven't been
# regenerated locally would silently produce a build with old bindings.
RUN rm -rf internal/repository/sqlcgen && sqlc generate

ARG VERSION=dev
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -trimpath \
        -ldflags "-s -w -X github.com/AGlElectronics/den/backend/internal/app.Version=${VERSION}" \
        -o /out/den-server ./cmd/server && \
    go build -trimpath \
        -ldflags "-s -w" \
        -o /out/den-migrate ./cmd/migrate

# -----------------------------------------------------------------------------
# Runtime: distroless static, non-root. Both binaries are copied in so the
# same image can run as either the server or the migrator (compose overrides
# `command:` for the one-shot migrate service).
# -----------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/den-server  /den-server
COPY --from=build /out/den-migrate /den-migrate
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/den-server"]
