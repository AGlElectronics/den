# syntax=docker/dockerfile:1.7

# -----------------------------------------------------------------------------
# Den backend image. Builds BOTH binaries from the same source tree:
#   /den-server   — the HTTP API (never runs migrations)
#   /den-migrate  — one-shot Goose runner used by Compose + K8s Jobs
# The default entrypoint is the server; the compose `migrate` service
# overrides it with `/den-migrate`. See docs/adr/0005-no-shared-postgres.md.
# -----------------------------------------------------------------------------
FROM golang:1.27.3-alpine3.24 AS build
WORKDIR /src

ENV CGO_ENABLED=0 GOFLAGS=-buildvcs=false

COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY backend ./

ARG VERSION=dev
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build -trimpath \
        -ldflags "-s -w -X github.com/AGlElectronics/den/backend/internal/app.Version=${VERSION}" \
        -o /out/den-server ./cmd/server && \
    go build -trimpath \
        -ldflags "-s -w" \
        -o /out/den-migrate ./cmd/migrate

# -----------------------------------------------------------------------------
# Runtime: distroless static, non-root. Both binaries are copied in so the
# same image can run as either the server or the migrator (compose overrides
# `command:` for the one-shot migrate service).
# -----------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/den-server  /den-server
COPY --from=build /out/den-migrate /den-migrate
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/den-server"]
