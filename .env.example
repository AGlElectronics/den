# ---- Den backend ------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:8090
HTTP_ADDR=:8090

# ---- PostgreSQL (matches infra/docker-compose.yml defaults) -----------------
# Host port 5434 avoids colliding with Stash's 5432.
DATABASE_URL=postgres://den:den@localhost:5434/den?sslmode=disable

# ---- Object storage ---------------------------------------------------------
# !!! MinIO is DEV ONLY. Do NOT use the compose MinIO in production.
# In prod, point these at a real managed S3-compatible bucket owned by Den.
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=den-data-dev
S3_ACCESS_KEY_ID=den
S3_SECRET_ACCESS_KEY=denden123
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
# Optional override for presigned URL host when the browser can't reach the
# in-cluster hostname. See backend/internal/files/client.go.
# S3_PUBLIC_BASE_URL=

# ---- Auth (human UI) --------------------------------------------------------
# dev = X-Dev-User header, auto-provisions users (fine for MVP).
# oidc = verify Bearer JWT against OIDC_ISSUER_URL (stubbed, see auth/oidc.go).
AUTH_MODE=dev
DEV_DEFAULT_USER=dev-admin
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=

# ---- Keycloak login branding -------------------------------------------------
# Den pushes its branding into the Keycloak realm (login theme "conservices",
# display name, brand attribute). Needs a confidential client with a service
# account holding realm-management manage-realm. Empty = disabled.
KEYCLOAK_ADMIN_URL=
# Defaults to the realm in OIDC_ISSUER_URL.
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=den-keycloak
KEYCLOAK_CLIENT_SECRET=

# ---- CORS -------------------------------------------------------------------
# Frontend dev server (rsbuild) runs on :3001.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ---- Shutdown ---------------------------------------------------------------
SHUTDOWN_TIMEOUT=15s

# ---- Frontend (Rsbuild) -----------------------------------------------------
# When the SPA is served behind nginx on the same origin as /api, leave empty.
# For `npm run dev` outside Docker, point at the backend.
VITE_API_BASE_URL=http://localhost:8090
VITE_AUTH_MODE=dev
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email
